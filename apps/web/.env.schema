# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/generated-env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
APP_SECRET=

# @public @dynamic @type=url
APP_URL=

# @type=string(minLength=1)
DATABASE_URL=

# DragonflyDB/Redis URL for the shared cache, auth sessions and auth rate limits.
# Unset for memory-only caching and Postgres-only sessions.
# @type=string @required=false
REDIS_URL=

# Keep a per-replica in-memory cache in front of REDIS_URL. Faster, but one replica can serve
# entries another replica already changed, for up to 10 minutes. Ignored without REDIS_URL.
# @type=boolean @required=false
APP_USE_INTERNAL_CACHE=false

# Run the background job worker inside this process. Set to false only when a separate worker
# container (`node build-worker/worker.js`, same image) runs, or deployments and monitoring jobs never run.
# @type=boolean @required=false
USE_INTERNAL_WORKER=true
