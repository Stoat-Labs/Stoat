        "@clowder/config": "workspace:*",
        "@clowder/db": "workspace:*",
        "@clowder/s3": "workspace:*",
        "@clowder/uncloud": "workspace:*",
        "@clowder/workflows": "workspace:*",
        "@orpc/server": "catalog:",
        "drizzle-orm": "catalog:",
        "effect": "4.0.0-rc.116",
        "ofetch": "catalog:",
        "unstorage": "^1.17.5",
        "valibot": "catalog:",
        "yaml": "catalog:"
    },
    "devDependencies": {
        "typescript": "catalog:"
    }
}
