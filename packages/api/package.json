{
    "name": "@clowder/api",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./*": {
            "types": "./src/*.ts",
            "default": "./src/*.ts"
        }
    },
    "scripts": {
        "build": "tsc -b",
        "check-types": "tsc -b"
    },
    "dependencies": {
        "@clowder/auth": "workspace:*",
